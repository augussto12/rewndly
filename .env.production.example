# Rewndly controlled VPS trial deploy.
# Rewndly is the public and technical project name.
# Copy to .env.production on the VPS and fill real values there.
# Never commit .env.production.

ASPNETCORE_ENVIRONMENT=Production

# Reverse proxy ports.
HTTP_PORT=80
HTTPS_PORT=443

# Nginx Proxy Manager trial deploy.
# NPM can proxy rewndly.com to http://127.0.0.1:18080 on the VPS.
FRONTEND_HTTP_BIND=127.0.0.1
FRONTEND_HTTP_PORT=18080

# Dedicated PostgreSQL container defaults.
POSTGRES_DB=rewndly_db
POSTGRES_OWNER_USER=rewndly_owner
POSTGRES_OWNER_PASSWORD=CHANGE_ME_STRONG_OWNER_PASSWORD
REWNDLY_APP_DB_USER=rewndly_app
REWNDLY_APP_DB_PASSWORD=CHANGE_ME_STRONG_APP_PASSWORD

# Backend DB connections. Keep PostgreSQL internal to Docker unless explicitly needed.
# MigrationConnectionStrings__DefaultConnection is used only by Rewndly.DbMigrator.
# ConnectionStrings__DefaultConnection is used by the API runtime and AdminSeeder.
MigrationConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=rewndly_db;Username=rewndly_owner;Password=CHANGE_ME_STRONG_OWNER_PASSWORD
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=rewndly_db;Username=rewndly_app;Password=CHANGE_ME_STRONG_APP_PASSWORD

# Public frontend origin only.
Cors__AllowedOrigins__0=https://rewndly.com

# Frontend build-time API base URL. Leave empty for same-origin reverse proxy.
VITE_API_BASE_URL=

# JWT. Jwt__Secret must be a strong random value, 32+ characters minimum.
Jwt__Issuer=Rewndly
Jwt__Audience=Rewndly.Web
Jwt__Secret=CHANGE_ME_STRONG_RANDOM_JWT_SECRET_32_PLUS_CHARS
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=14

# Refresh cookie. Use Lax for same-site reverse proxy. Use None only when API and frontend are cross-site and HTTPS is enabled.
Cookie__Domain=
Cookie__SameSite=Lax

# TMDB. Server-side only. Never expose these values to Vite/frontend.
# Prefer TMDB_ACCESS_TOKEN or Tmdb__AccessToken as a Bearer token.
# Tmdb__ApiKey / TMDB_API_KEY is a v3 fallback only.
# Use the public application/domain Rewndly / rewndly.com when requesting TMDB access.
TMDB_ACCESS_TOKEN=
Tmdb__AccessToken=
TMDB_API_KEY=
Tmdb__ApiKey=
Tmdb__BaseUrl=https://api.themoviedb.org/3
Tmdb__ImageBaseUrl=https://image.tmdb.org/t/p
Tmdb__PosterSize=w500
Tmdb__BackdropSize=w1280
Tmdb__TimeoutSeconds=10

# Production-safe bootstrap admin. Do not use Admin123!.
REWNDLY_ADMIN_USERNAME=Colucho
REWNDLY_ADMIN_EMAIL=admin@rewndly.com
REWNDLY_ADMIN_INITIAL_PASSWORD=CHANGE_ME_ONE_TIME_STRONG_ADMIN_PASSWORD_16_PLUS_CHARS

# Future email provider placeholders.
Mail__Provider=
Mail__ApiKey=
