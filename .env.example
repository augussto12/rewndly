# MovieSys local development

# PostgreSQL
POSTGRES_DB=moviesys_dev
POSTGRES_USER=moviesys
POSTGRES_PASSWORD=moviesys_dev_password
MOVIESYS_CONNECTION_STRING=Host=localhost;Port=5432;Database=moviesys_dev;Username=moviesys;Password=moviesys_dev_password

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development
MOVIESYS_CORS_ALLOWED_ORIGINS=http://localhost:5173
Jwt__Secret=change-this-in-production-minimum-32-characters
Jwt__Issuer=MovieSys
Jwt__Audience=MovieSys.Web
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=14

# Frontend
VITE_API_BASE_URL=http://localhost:5231

# TMDB must only be used by the backend.
TMDB_API_KEY=
TMDB_ACCESS_TOKEN=
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
Tmdb__ApiKey=
Tmdb__AccessToken=
Tmdb__BaseUrl=https://api.themoviedb.org/3
Tmdb__ImageBaseUrl=https://image.tmdb.org/t/p
Tmdb__PosterSize=w500
Tmdb__BackdropSize=w1280
Tmdb__TimeoutSeconds=10

# Initial admin seed.
# Development may use Admin123! because the account must force password change.
# Production must provide a strong one-time password through server secrets.
MOVIESYS_ADMIN_USERNAME=Colucho
MOVIESYS_ADMIN_EMAIL=
MOVIESYS_ADMIN_INITIAL_PASSWORD=Admin123!
MOVIESYS_ADMIN_MUST_CHANGE_PASSWORD=true

# Future email provider integration.
MAIL_PROVIDER=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
