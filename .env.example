# Rewndly local development

# PostgreSQL
POSTGRES_DB=rewndly_dev
POSTGRES_USER=rewndly
POSTGRES_PASSWORD=rewndly_dev_password
REWNDLY_CONNECTION_STRING=Host=localhost;Port=5432;Database=rewndly_dev;Username=rewndly;Password=rewndly_dev_password

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development
REWNDLY_CORS_ALLOWED_ORIGINS=http://localhost:5173
Jwt__Secret=change-this-in-production-minimum-32-characters
Jwt__Issuer=Rewndly
Jwt__Audience=Rewndly.Web
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=14

# Frontend
VITE_API_BASE_URL=http://localhost:5231

# TMDB must only be used by the backend. Do not expose these values to Vite/frontend.
# Prefer the read access token. The API key is a v3 fallback only.
TMDB_ACCESS_TOKEN=
Tmdb__AccessToken=
TMDB_API_KEY=
Tmdb__ApiKey=
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
Tmdb__BaseUrl=https://api.themoviedb.org/3
Tmdb__ImageBaseUrl=https://image.tmdb.org/t/p
Tmdb__PosterSize=w500
Tmdb__BackdropSize=w1280
Tmdb__TimeoutSeconds=10

# MDBList ratings enrichment. Server-side only; never expose this to Vite/frontend.
MDBLIST_API_KEY=nrudz81xk8unudxmjamvnznxd
MDBLIST_BASE_URL=https://api.mdblist.com
MdbList__Enabled=true
MdbList__CacheHours=24
MdbList__RankingCacheHours=24
MdbList__RankingLimit=100
MdbList__ImdbRankingCandidateLimit=500
MdbList__ImdbMinimumVotes=25000
MdbList__ImdbPriorMean=7.0
MdbList__TimeoutSeconds=15

# Initial admin seed.
# Development may use Admin123! because the account must force password change.
# Production must provide a strong one-time password through server secrets.
REWNDLY_ADMIN_USERNAME=Colucho
REWNDLY_ADMIN_EMAIL=
REWNDLY_ADMIN_INITIAL_PASSWORD=Admin123!
REWNDLY_ADMIN_MUST_CHANGE_PASSWORD=true

# Future email provider integration.
MAIL_PROVIDER=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
